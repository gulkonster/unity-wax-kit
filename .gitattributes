# Normalize line endings
* text=auto

# Unity YAML
*.unity    text eol=lf
*.asset    text eol=lf
*.prefab   text eol=lf
*.mat      text eol=lf
*.meta     text eol=lf

# Binary
*.png  binary
*.jpg  binary
*.ttf  binary
*.otf  binary
*.dll  binary

# GitHub language stats: TextMesh Pro shaders are Unity's, not the kit's (the kit is C#)
Assets/TextMesh[[:space:]]Pro/** linguist-vendored
